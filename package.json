{
  "name": "pricefollower",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "PRICEFOLLOWER_ENV=development go run ./cmd/pricefollower",
    "dev:web": "vite --host 0.0.0.0",
    "start": "./release/pricefollower",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:platform-tabs": "playwright test tests/platform-tabs.spec.ts",
    "test:settings": "playwright test tests/leboncoin-session-settings.spec.ts",
    "test:item-refresh": "playwright test tests/item-refresh.spec.ts"
  },
  "dependencies": {
    "@carbon/icons-react": "^11.89.0",
    "@carbon/react": "^1.117.0",
    "@carbon/styles": "^1.116.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
